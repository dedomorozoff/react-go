# App Configuration
APP_NAME=React-Go
APP_ENV=local
APP_PORT=8080

# CORS (comma-separated, no wildcard with credentials)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DB_PATH=app.db

# Security (generate a strong random value for production!)
JWT_SECRET=REPLACE_ME_GENERATE_RANDOM_32_BYTES
JWT_EXPIRES_IN=24h

# Admin Setup
# ADMIN_PASSWORD=password123
